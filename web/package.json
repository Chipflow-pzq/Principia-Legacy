    "katex": "^0.16.25",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/cytoscape": "^3.21.9",
    "@types/katex": "^0.16.7",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  }
}
