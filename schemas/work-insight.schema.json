{
  "$id": "urn:principia-legacy:catalog:work-insight:2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "anchors": {
      "items": {
        "properties": {
          "anchor_id": {
            "type": "string"
          },
          "source_id": {
            "type": "string"
          },
          "source_revision": {
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "source_id",
          "source_revision",
          "anchor_id"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "contribution": {
      "properties": {
        "content_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "revision",
        "content_hash"
      ],
      "type": "object"
    },
    "reason": {
      "minLength": 1,
      "type": "string"
    },
    "role": {
      "enum": [
        "establishes",
        "uses",
        "explains",
        "discusses"
      ]
    },
    "work": {
      "properties": {
        "content_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "revision",
        "content_hash"
      ],
      "type": "object"
    },
    "work_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "work_id",
    "work",
    "contribution",
    "role",
    "reason",
    "anchors"
  ],
  "type": "object"
}
