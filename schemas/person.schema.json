{
  "$id": "urn:principia-legacy:catalog:person:2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "aliases": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "bio_sources": {
      "items": {
        "properties": {
          "note": {
            "minLength": 1,
            "type": "string"
          },
          "title": {
            "minLength": 1,
            "type": "string"
          },
          "url": {
            "pattern": "^https://",
            "type": "string"
          }
        },
        "required": [
          "title",
          "url",
          "note"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "biography": {
      "minLength": 1,
      "type": "string"
    },
    "content_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "kind": {
      "const": "person"
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "type": "integer"
    },
    "selection_reason": {
      "minLength": 1,
      "type": "string"
    },
    "subjects": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "id",
    "revision",
    "content_hash",
    "name",
    "kind",
    "biography",
    "selection_reason",
    "aliases",
    "bio_sources"
  ],
  "type": "object"
}
